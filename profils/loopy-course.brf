# Loopy - course à pied. Profil écrit pour Loopy (format BRouter, https://github.com/abrensch/brouter).
# Préfère les voies piétonnes, parcs, promenades, chemins et voies vertes, les espaces boisés et les bords
# d'eau ; les grands axes ne sont acceptés que s'ils ont un trottoir ; autoroutes, voies interdites aux
# piétons et accès privés exclus ; escaliers évités quand il existe une alternative.

---context:global

assign validForFoot = true
assign processUnusedTags = false
assign turnInstructionMode = 1
assign downhillcost = 0
assign downhillcutoff = 1.5
assign uphillcost = 0
assign uphillcutoff = 1.5
assign correctMisplacedViaPoints = true
assign correctMisplacedViaPointsDistance = 400
assign allow_steps = false   # %allow_steps% | Escaliers acceptés sans pénalité | boolean

---context:way

assign turncost = 0
assign initialclassifier = if route=ferry then 1 else 0
assign initialcost = switch route=ferry 10000 0
# sortie des étiquettes de revêtement dans la réponse, pour l'indicateur de confiance
assign dummyUsage = or surface= or smoothness= or bicycle= bicycle_road=

assign defaultaccess = switch access= not motorroad=yes switch or access=private access=no false true
assign issidewalk = not or sidewalk= or sidewalk=none sidewalk=no
assign footaccess = or issidewalk switch foot= defaultaccess not or foot=private or foot=no foot=use_sidepath

assign no_green_penalty =
   switch estimated_forest_class=  0.35
   switch estimated_forest_class=1 0.25
   switch estimated_forest_class=2 0.18
   switch estimated_forest_class=3 0.1
   switch estimated_forest_class=4 0.05 0

assign no_river_penalty =
   switch estimated_river_class=  0.15
   switch estimated_river_class=1 0.1
   switch estimated_river_class=2 0.05 0

assign costfactor
  switch and highway= not route=ferry  100000
  switch route=ferry 100000
  switch not footaccess 100000
  switch highway=motorway|motorway_link|trunk|trunk_link 100000
  switch highway=construction|proposed|abandoned|platform|corridor 100000
  add no_green_penalty
  add no_river_penalty
  switch highway=primary|primary_link     switch issidewalk 1.8 6
  switch highway=secondary|secondary_link switch issidewalk 1.4 3
  switch highway=tertiary|tertiary_link   switch issidewalk 1.3 2
  switch highway=unclassified switch issidewalk 1.25 1.5
  switch highway=residential|living_street 1.25
  switch highway=service 1.5
  switch highway=pedestrian|footway 1.0
  switch highway=path switch sac_scale=|hiking 1.0 5
  switch highway=track switch tracktype=|grade1|grade2|grade3 1.05 1.6
  switch highway=cycleway 1.2
  switch highway=bridleway 3
  switch highway=steps switch allow_steps 1.5 6
  2.0

---context:node

assign defaultaccess = switch access= true switch or access=private access=no false true
assign footaccess = switch foot= defaultaccess not or foot=private foot=no
assign initialcost = switch footaccess 0 1000000
